<header>
    <div class="logo-opciones">
        <a href="/">
            <img src="/img/logo.png" alt="BTS Logo">
        </a>
        <div class="opciones">
            <% mostrarOpciones(session); %>
        </div>
    </div>

    <div class="saludo">
        <% mostrarSaludo(session); %>
    </div>
</header>

<% function mostrarSaludo(session) { %>
    <% if(session.login) { %>
        <img src="/static/img/<%= session.picture %>" alt="Foto de perfil"/>
        <p>
            <a href="/content/normal"> <%= session.name %></a>

        </p>
        <p>
            <a href='/users/logout'> Logout</a>
        </p>
    <% } else { %>
        <a href='/users/login'> Login</a>
        <a href='/users/register'> Register</a>
    <% } %>
<% } %>

<% function mostrarOpciones(session) { %>

 
        <% if (session.esAdmin) { %>
            <a href="/content/admin">Administrador</a><br>
        <% } %>


        <% if (session.esJournal) { %>
            <a href="/content/journal">Artículos</a><br>
        <% } %>

<% } %>
