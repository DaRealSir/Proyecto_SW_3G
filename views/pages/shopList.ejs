 <p> Herramientas admin : <a href="/shop/addShop"> Añadir tienda</a> </p>
<div class="game_list">
    <div class="game_list_grid">
        <% shopList.forEach(shop=>{ %>
            <div class="game-card">
                <h3 class = "game_title"><a href="/shop/<%= shop.id %>"><%= shop.name %></a></h3>
                <a href="/shop/<%= shop.id %>"><img src="<%= shop.image %>" alt="Imagen de <%= shop.name %>"></a>
            </div>
         <% }) %>
    </div>
</div>

<div class = "buttons-page">
    <p>
        <button onclick="goPreviousPage()" > Anterior </button>
        <button onclick="goNextPage()"> Siguiente </button>
    </p>
</div>



<script>


    function goPreviousPage() {
        let pageNumber = <%= page %> || 1;
        if (pageNumber >= 2){
            let numPage = pageNumber - 1;
             window.location.href = `/shop/shopList/page/${pageNumber - 1}`;
        }
    }
    function goNextPage() {
        let pageNumber = <%= page %> || 1;
        let numPage = pageNumber + 1;
        
         window.location.href = `/shop/shopList/page/${pageNumber + 1}`;
    }
</script>