<button onclick="toggleVisibilityGenres()" class="dropdown_genres_button">Géneros</button>
<div id="dropdown_genres_content" class="dropdown_genres_content visible">
    <% if (genreList && genreList.length > 0) { %>
        <% genreList.forEach(genre => { %>
            <div class="genre_block">
                <p><%= genre.name %>
                    <% if(session.esAdmin) { %>
                        <form action="/genres/deleteGenre/<%= genre.id %>/<%=game.id%>" method="POST">
                            <button type="submit">Borrar</button>
                        </form>
                    <% } %>
                </p>
                <p></p>
            </div>
        <% }) %>
    <% } else { %>
        <p>No hay géneros asignados aún.</p>
    <% } %>
</div>

<% if(session.esAdmin) { %>
    <form action="/genres/addGenre/<%=game.id%>" method="POST">
        <input type="text" name="genre_name" required>
        <button type="submit">Añadir</button>
    </form>
<% } %>

<script>
    function toggleVisibilityGenres() {
        const dropdown = document.getElementById('dropdown_genres_content');
        if (dropdown) {
            dropdown.classList.toggle('hidden');
            dropdown.classList.toggle('visible');
        }
    }
</script>
