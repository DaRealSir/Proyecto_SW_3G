<button onclick="toggleVisibility()" class="dropdown_genres_button">Géneros</button>
<% if (genreList !== 'undefined') { %>
    <div id="dropdown_genres_content" class="dropdown_genres_content">
            <% genreList.forEach(genre => { %>
                <div class="genre_block">
                <p><%= genre.name %>
                    <% if(session.esAdmin) { %>
                    <form id="filters" action="/genres/deleteGenre/<%= genre.id %>/<%=game.id%>" method="POST">
                    <button type="submit">Borrar</button>
                    </form>
                    <% } %>
                </p>
            </div>
            <p> </p>
            <% }) %>
        </div>
    <% if(session.esAdmin) { %>
    <form id="filters" action="/genres/addGenre/<%=game.id%>" method="POST">
        <input type = "text" name="genre_name"><button type="submit"">Añadir</button>
    </form>
    <% } %>
<% } %>
<script>
    function toggleVisibility() {
        let x = document.getElementById('dropdown_genres_content');
        if (x.classList.contains('hidden')) {
            x.classList.remove('hidden');
            x.classList.add('visible');
        } else {
            x.classList.remove('visible');
            x.classList.add('hidden');
        }
    } 
    //cambiar estilo css dinamicamente a traves de js sacado de: https://www.w3schools.com/js/js_htmldom_css.asp
</script> 
