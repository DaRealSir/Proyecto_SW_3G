<h1 class="page-title">My Publications</h1>

<div class="list">
  <% newslist.forEach(News => { %>
    <div class="list-item">
      <form action="/guides/<%= News.id %>" method="GET">
        <button class="form-button" type="submit">
          <span class="item-title"><%= News.title %></span>
          <span class="item-subtitle"><%= News.date %></span>
        </button>
      </form>
    </div>
  <% }) %>
</div>
