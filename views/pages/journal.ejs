<h1>My Publications</h1>

<div id="news_list">
 <% showNewsList() %>
</div>

<% function showUserList() { %>
    <% newslist.forEach(News => { %>
    <div id="Noticia">
        <form action="/guides/<%= News._id %>" method="GET">
            <button type="submit"><%= News._title %> <%= News._date %></button>
        </form>
    </div>
    
    <% }) %>
<% } %>