
<script src="/js/forum-script.js"></script>

<section class="forum-container">
    <% if (session.login) { %>
        <button class="create-forum" onclick="location.href='/forum/reply/<%= game.id %>/-1'">Nuevo Hilo</button>
    <% } %>
    <% showThreadInfoRecursive(-1, threadList.last_post); %>
</section>

<% function showThreadInfoRecursive(last_id, num_replies) { %>
    <% let threads = threadList.filter(thread => thread.original_post_id === last_id); %>
    <%let i = 0;%>
    <% threads.forEach(thread => { %>
        <% i++; %>
        <section class="forum-group">
            <h1><%= thread.title %></h1>
            <% reply(thread.game_id, thread.id); %>
            <% eliminate(thread.game_id, thread.id); %>
            <p>Creado por: <%= thread.user_name %></p>
            <p>Descripción: <%= thread.description %></p>
            <p>Respuestas: <%= thread.replies %></p>
            
            <% if (thread.replies > 0 && last_id != -1) { %>
                <div id="ver_respuestas-<%= thread.id %>">
                    <a href="#" class="show-reply" onclick="showMore('<%= thread.game_id %>',<%= thread.id %>, 0, 'ver_respuestas-<%= thread.id %>')">Ver respuestas</a>
                </div>
            <% } %>
            
            <% showThreadInfoRecursive(thread.id, thread.replies); %> 
        </section>
    <% }); %>
    <% if (num_replies > threads.length && threads.length > 0) { %>
        <div id="ver_mas-<%= last_id %>"> 
            <button class="show-more" onclick="showMore(<%= game.id %>, <%= last_id %>, 3, 'ver_mas-<%= last_id %>')">Ver más</button>
        </div>
    <% } %>
<% } %>

<% function reply(g_id, id) { %>
    <% if (session.login) { %>
        <button class="reply-button" data-thread-id="<%= id %>" data-game-id="<%= g_id %>">Responder</button>
    <% } %>
<% } %>

<% function eliminate(g_id, id) { %>
    <% if (session.esAdmin) { %>
        <button class="delete-button" data-thread-id="<%= id %>" data-game-id="<%= g_id %>">Eliminar</button>
    <% } %>
<% } %>


