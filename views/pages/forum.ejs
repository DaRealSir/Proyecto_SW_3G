
<script src="/js/forum-script.js"></script>

<section class="forum-container" id="forum-container">
    <% if (session.login) { %>
        <a href="#" class="create-forum" data-game-id='<%= game.id %>' data-last-id ='-1'>Nuevo Hilo</a>
        <% replyModal(); %>
        <% if (session.esAdmin) { %>
            <% deleteModal(); %>
        <% } %>
    <% } %>
    <% showThreadInfoRecursive(-1, threadList.last_post); %>
</section>

<% function showThreadInfoRecursive(last_id, num_replies) { %>
    <% let threads = threadList.filter(thread => thread.original_post_id === last_id); %>
    <%let i = 0;%>
    <% threads.forEach(thread => { %>
        <% i++; %>
        <section class="forum-group" id = "thread-<%= thread.id %>">
            <h1 class = thread-title><%= thread.title %></h1>
            <p class = thread-username>Creado por: <%= thread.user_name %></p>
            <p class = thread-message><%= thread.description %></p>
            <p>Respuestas: <%= thread.replies %></p>
            about:blank#blocked
            <% reply(thread.id); %>
            <% eliminate(thread.game_id, thread.id); %>

            <% if (thread.replies > 0 && last_id != -1) { %>
                <div id="ver_respuestas-<%= thread.id %>">
                    <a href="#" class="show-reply" data-game-id ='<%= thread.game_id %>' data-last-id = '<%= thread.id %>' data-offset = "0" data-where-id= '<%= thread.id %>')">Ver respuestas</a>
                </div>
            <% } %>
            
            <% showThreadInfoRecursive(thread.id, thread.replies); %> 
        </section>
    <% }); %>
    <% if (num_replies > threads.length && threads.length > 0) { %>
        <div id="ver_mas-<%= last_id %>"> 
            <a href = "#" class="show-more" data-game-id="<%= game.id %>" data-last-id = "<%= last_id %>" data-offset = "3" data-where-id='<%= last_id %>'>Ver más</a>
        </div>
    <% } %>
<% } %>

<% function reply(id) { %>
    <% if (session.login) { %>
        <a href="#replyModal" class="reply-button" data-thread-id="<%= id %>">Responder</a>
    <% } %>
<% } %>

<% function eliminate(g_id, id) { %>
    <% if (session.esAdmin) { %>
        <a href="#deleteModal" class="delete-button" data-thread-id="<%= id %>" data-game-id="<%= g_id %>">Eliminar</a>
    <% } %>
<% } %>

<%function replyModal() { %>
    <div class="oscurecer" id="replyModal">
        <div class="dialogo" >
            
        </div>
    </div>
<% } %>
<%function deleteModal() { %>
    <div class="oscurecer" id="deleteModal">
        <div class="dialogo" >

        </div>
    </div>
<% } %>
