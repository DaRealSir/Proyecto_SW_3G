
<script src="/js/forum-script.js"></script>
<% showThreadInfo() %>

<% function showThreadInfo() { %>

    <% threadList.forEach(thread => { %>
        <section class="forum-group" id = "thread-<%= thread.id %>">
            <%- include('../partials/forumSection', { thread , first: false }) %>
        </section>
    <% }); %>
    <% if (last_position > 0) { %>
        <div id="ver_mas-<%= last_id %>">    
            <a href="#" class="show-more" data-game-id = '<%= game_id %>' data-last-id = '<%= last_id %>' data-offset = '<%= last_position - threadList.length %>' data-where-id = '<%= last_id %>'>Ver más</a>
        </div>
    <% } %>
<% } %>
