<h1 class="page-title">Seleccione el usuario que quiere eliminar</h1>

<form action="/users/listausuarios" method="POST" class="search-form">
  <label for="UserName">Search</label>
  <input type="text" name="UserName">

  <button class="form-button" type="submit">Buscar</button>

  <label for="options">Ordenado por:</label>
  <select id="options" name="order_option">
    <option value="optionSinOrden">Sin orden</option>
    <option value="optionAlfabetico">Alfabético</option>
    <option value="optionType">User Type</option>
  </select>

  <select id="asc_desc_option" name="asc_desc_option">
    <option value="optionDesc">Descendente</option>
    <option value="optionAsc">Ascendente</option>
  </select>
</form>

<div class="list">
  <% showUserList() %>
</div>

<% function showUserList() { %>
  <% userList.forEach(User => { %>
    <% if(User.id !== session.UserID) { %>   
      <div class="list-item">
        <form action="/users/delete/<%= User.id %>" method="POST">
          <input type="hidden" name="username" value="<%= User.username %>">
          <button class="form-button danger" type="submit">
            Eliminar <%= User.username %>
          </button>
        </form>
      </div>
    <% } %>
  <% }) %>
<% } %>
