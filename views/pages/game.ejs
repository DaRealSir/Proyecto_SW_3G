<% adminOptions(session) %>

<section>
    <div class="juego_info_superior">
        <div class="juego_info">
            <% showGameInfo() %>
            <%- include('showGameGenres') %>
        </div>
        <div class="juego_info2">
            <% showGameInfo2() %>
        </div>
    </div>

    <div class="juego_info3">
        <h3>NOTICIAS Y GUIAS</h3>
        <% showGameInfo3() %>
    </div>
    <div class="juego_info3">
        <h3> REVIEWS </h3>
        <%- include('reviews/userReviews') %>
    </div>
    <div class="juego_info3">
        <h3> FORO </h3>
        <%- include('forum') %>
    </div>

</section>



<script>console.log("USERIDDDDD" + session.UserID)</script>


<form action="/games/addReview/<%= game.id %>" method="GET">
    <input type="hidden" name="user_id" value="<%= session.UserID %>">
    <button type="submit">Añadir review </button>
</form>


<% function showGameInfo(){ %>
    <h1><u><%= game.title %></u></h1>
    <a href="/games/<%= game.id %>"><img src="<%= game.image %>" alt="Imagen de <%= game.title %>"></a>
    <p>Valoracion media: <%= game.rating %></p>
    <p>Numero Favoritos: <%= game.favNumber %></p>
<% } %>

<% function showGameInfo2(){ %>
    <p><u>Descripción del juego</u>:  <%= game.description %></p>
    <p><u>Desarrollado por</u>: Empresa 1</p>

    <p><u>Publicado por</u>: Empresa 2</p>
    <p><u>Añadir a tu lista personal</u> :<button> Añadir</button></p>

    <p>Disponible en las siguientes tiendas :</p>

    <% shopList.forEach(shop=>{ %>
        
        <div class="shop-games">
            <a href="<%= shop.url %>"><img src="<%= shop.image %>" alt="Imagen de <%= shop.name %>"></a>
           
</div>
     <% }) %>


<% } %>

<% function showGameInfo3(){ %>



    <p>......</p>
    <p>......</p>
<% } %>


<% function adminOptions(session) { %>
    <% if(session.esAdmin) { %>
    <p> Herramientas admin:
    <form action="/games/deleteGame/<%= game.id %>" method="POST" style="display:inline;">
        <button type="submit">Eliminar juego</button>
    </form>

    <form action="/games/modifyGame/<%= game.id %>" method="GET" style="display:inline;">
        <button type="submit">Modificar juego</button>
    </form>
    <% } %>
<% } %>

