<article class="full-guide">
    <h1 class="full-guide-title"><%= guide._title %></h1>

    <div class="full-guide-meta">
        <span class="guide-type">
      <%= guide._guide_type === 'N' ? 'Noticia' : 'Guía' %>
    </span>
        &nbsp;|&nbsp;
        <span class="guide-date">
      <%= new Date(guide._date).toLocaleDateString('es-ES', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric'
      }) %>
    </span>
        &nbsp;|&nbsp;
        <span class="guide-user">
      Por <a href="/users/<%= guide._user_id %>"><%= guide._user_name %></a>
    </span>
        &nbsp;|&nbsp;
        <span class="guide-game">
      Juego: <a href="/games/<%= guide._game_id %>"><%= guide._game_title %></a>
    </span>
        <%if(guide._user_id === session.UserID){%>
            <a href="/guides/addGuide/<%= guide._game_id %>?guide_id=<%= guide.id %>"
                    class="btn-edit-guide"> Editar guía </a>
        <%}%>
    </div>

    <div class="full-guide-content">
        <%- guide._content %>
    </div>
</article>