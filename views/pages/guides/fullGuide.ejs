<article class="full-guide">
    <h1 class="full-guide-title"><%= guide.title %></h1>

    <div class="full-guide-meta">
        <span class="guide-type"><%= guide.guide_type === 'N' ? 'Noticia' : 'Guía' %></span>
        &nbsp;|&nbsp;
        <span class="guide-date">
      <%= new Date(guide.date).toLocaleDateString('es-ES', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric'
      }) %>
    </span>
        &nbsp;|&nbsp;
        <span class="guide-user">Por <%= guide.user_name %></span>
    </div>

    <div class="full-guide-content">
        <%= guide.content %>
    </div>
</article>