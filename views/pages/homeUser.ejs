<h1>Mis Listas</h1>

<div id="lists_container" class="game_list">

  <div class="list_column game_list_grid">
    <h2>My Guides</h2>
    <% listGuides.forEach(guide => { %>
      <div class="game-card list_item">
        <form action="/guides/<%= guide.id %>" method="GET" style="width: 100%;">
          <button class="form-button" type="submit" style="width: 100%; padding: 10px; border-radius: 5px; background-color: #4d0b5e; color: white; border: none; cursor: pointer;">
            <%= guide.title %>
          </button>
        </form>
      </div>
    <% }) %>
  </div>

  <div class="list_column game_list_grid">
    <h2>My Games</h2>
    <% listGames.forEach(game => { %>
      <div class="game-card list_item" style="display: flex; justify-content: space-between; align-items: center; padding: 5px 10px;">
        <form action="/games/<%= game.id %>" method="GET" style="flex-grow: 1; margin-right: 10px;">
          <button class="form-button" type="submit" style="width: 100%; padding: 10px; border-radius: 5px; background-color: #4d0b5e; color: white; border: none; cursor: pointer; text-align: left;">
            <%= game.title %>
          </button>
        </form>
        <form action="/game_user/delete/<%= game.id %>" method="POST" style="margin: 0;">
          <button type="submit" class="delete_button" style="background-color: #cc0000; border: none; color: white; font-weight: bold; padding: 5px 12px; border-radius: 5px; cursor: pointer;">X</button>
        </form>
      </div>
    <% }) %>
  </div>

</div>