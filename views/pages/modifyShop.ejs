<h1> Modificacion de datos de una tienda</h1>

<% if (1 === 1) { %>
<form action="/shop/modifyShop/<%= shop.id %>" method="POST">
    <fieldset>
        <% if (locals.error) { %>
            <p><strong><%= locals.error %></strong></p>
        <% } %>
        <% if (locals.exito) { %>
            <p><strong><%= locals.exito %></strong></p>
        <% } %>
        <legend> Modificar Tieda : <%= shop.name %></legend>
        <label>Nombre:</label> <input type="text" name="name" value="<%= info.name %>"><%- helpers.error(errores, 'name') %>
        <p></p>
        <label>URL_Imagen:</label> <input type="text" name="image" value="<%= info.image %>"><%- helpers.error(errores, 'image') %>
        <p></p>
        <button type="submit">Enviar</button>
    </fieldset>
</form>

<% } else { %>

    <p> Juego inexistente</p>
<% } %>
